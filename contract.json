{
  "base_url": "http://localhost:8000",
  "resource": "teams",
  "id_field": "id",
  "missing_id": "999999",
  "list_key": null,
  "create": { "name": "Быстрые лошадки", "city": "Москва", "maxPlayers": 10 },
  "update": { "maxPlayers": 12 },
  "required_field": "name",
  "errors": [
    { "body": { "name": "" }, "field": "name" },
    { "body": { "city": "" }, "field": "city" },
    { "body": { "maxPlayers": -1 }, "field": "maxPlayers" }
  ],
  "filter": { "param": "city", "value": "Москва", "other": "Казань" },
  "text_field": "name",
  "child": {
    "resource": "players",
    "create": {
      "fullName": "Иванов Иван",
      "number": 7,
      "birthDate": "2005-03-14",
      "horseName": "Ветерок"
    },
    "parent_field": "teamId"
  },
  "search": { "param": "q", "field": "name" },
    "rule": {
    "description": "В команде не больше maxPlayers игроков",
    "parent": { "maxPlayers": 1 },
    "setup": [
      {
        "method": "POST",
        "path": "/api/teams/{id}/players",
        "body": { "fullName": "Первый Игрок", "number": 1, "birthDate": "2005-03-14" }
      }
    ],
    "violate": {
      "method": "POST",
      "path": "/api/teams/{id}/players",
      "body": { "fullName": "Второй Игрок", "number": 2, "birthDate": "2005-03-15" }
    },
    "expect_status": 409
  },
  "stats_path": "/api/teams/stats",
  "auth": {
    "scheme": "basic",
    "register_path": "/auth/register",
    "me_path": "/auth/me",
    "login_field": "username",
    "password_field": "password",
    "owner_field": "ownerId"
  }
}